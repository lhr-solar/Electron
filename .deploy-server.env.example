# Copy to .deploy-server.env (gitignored) for the Windows telemetry host.
INFLUX_TOKEN=place-token-here
GRAFANA_URL=http://127.0.0.1:3000
DATA_FOLDER=D:\LHR Telemetry
ELECTRON_MODE=server
MANAGE_PASSWORD=change-me
SERVE_STATIC_CLIENT=1
# Leave SOCKET_CORS_ORIGINS unset (defaults to *) for public tunnel hosts.
# SOCKET_CORS_ORIGINS=https://electron.lhrsolar.org
