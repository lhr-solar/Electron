# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
#   cp deploy/.env.example deploy/.env

# --- InfluxDB (sink + Grafana datasource) ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-please
INFLUX_ORG=LHRS
INFLUX_BUCKET=telemetry_main
# Admin/all-access token: shared by the backend sink + Grafana datasource.
# Generate a long random value, e.g.  openssl rand -base64 48
INFLUX_TOKEN=change-me-influx-token

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-please

# --- Host port mappings ---
BACKEND_PORT=8350     # REST/WS API + served web app  -> http://localhost:8350
SLCAN_PORT=8187       # TCP slcan listener (vehicle connects here)
GRAFANA_PORT=3000     # Grafana UI -> http://localhost:3000
