# Headless server-mode backend image.
#
# Stage 1 builds the web app (app/dist) so the server hosts the SAME app the
# desktop uses. Stage 2 is the lean Python runtime. Grafana dashboards are
# generated separately on the host (deploy/generate-dashboards.sh) and mounted.
#
# Build context is the REPO ROOT:
#   docker compose -f deploy/docker-compose.yml build

# ---- Stage 1: web app build -------------------------------------------------
FROM node:22-slim AS web
WORKDIR /repo

# Build the React app -> app/dist. If app/ is absent in the context, skip; the
# backend then serves its placeholder page (still boots).
COPY app/ app/
RUN if [ -f app/package.json ]; then \
      cd app && (npm ci --no-audit --no-fund || npm install --no-audit --no-fund) && npm run build; \
      mkdir -p /out/app && cp -r app/dist /out/app/dist; \
    else \
      echo "no app/ in context — backend will serve placeholder"; \
      mkdir -p /out/app/dist; \
    fi

# ---- Stage 2: Python backend runtime ---------------------------------------
FROM python:3.12-slim AS runtime
WORKDIR /repo
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Schemas the backend validates against + MDC examples the FakeEngine reads.
COPY engine/config.schema.json engine/config.schema.json
COPY Embedded-Sharepoint/can/mdc/ Embedded-Sharepoint/can/mdc/
COPY Embedded-Sharepoint/can/vehicles/lhr-ev1/ Embedded-Sharepoint/can/vehicles/lhr-ev1/

# Backend package (install runtime deps only — no dev/analytics in the image).
COPY backend/ backend/
RUN pip install --no-cache-dir -e backend

# Built web app from stage 1 (Grafana dashboards are generated on the host into
# deploy/grafana-dashboards by deploy/generate-dashboards.sh and mounted into
# Grafana — see docker-compose.yml).
COPY --from=web /out/app/dist app/dist

ENV BACKEND_CONFIG=/repo/backend/examples/server.config.json
EXPOSE 8350 8187
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8350"]
