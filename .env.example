INFLUX_TOKEN=place-token-here
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_SUBPATH=/grafana
DBC_DIR=absolute-path-to-dbc-files
LOG_DIR=absolute-path-to-log-directory
TRASH_DIR=absolute-path-to-trash-directory

# client (default) = combined UI. server = public viewers at /, passworded /manage.
ELECTRON_MODE=client
# Required when ELECTRON_MODE=server. Password-only (no username).
MANAGE_PASSWORD=