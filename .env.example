INFLUX_TOKEN=place-token-here
GRAFANA_URL=http://127.0.0.1:3000
# Empty when Grafana serves at root (dedicated hostname). Set /grafana for legacy subpath.
GRAFANA_SUBPATH=
GRAFANA_PUBLIC_URL=https://grafana.lhrsolar.org/
INFLUX_PUBLIC_URL=https://influx.lhrsolar.org/
# Service-account token with Live push permission (Editor+). Empty = Influx-only writes.
GRAFANA_LIVE_TOKEN=
GRAFANA_LIVE_STREAM_ID=telemetry

# Root for logs/, .trash/, .db/ (Influx+Grafana data). Default: project root (./).
# DATA_FOLDER=/absolute/path/to/data

# client (default) = combined UI. server = public viewers at /, passworded /manage.
ELECTRON_MODE=client
# Required when ELECTRON_MODE=server. Password-only (no username).
MANAGE_PASSWORD=
